{"working_matter_snapshot":{"language":"English","warnings":[],"schemaVersion":"1","formattingSummary":{"runs":12,"fonts":[],"tables":0,"listItems":0,"paragraphs":12,"italicParagraphs":0,"justifiedParagraphs":0},"paragraphs":[{"id":"matter-p-1","runs":[{"bold":false,"text":"The public hospital regularly recorded notes about the local history project while the children watched with interest. Most families happily organised the district fair in time for the festival at the end of the month. The city council published a short note on the school garden so the results could be shared on Friday.","color":null,"italic":false,"strike":false,"fontSize":12,"highlight":null,"underline":false,"fontFamily":null}],"type":"paragraph","alignment":"left","listGroup":null,"leftIndent":0,"spaceAfter":8,"lineSpacing":1.15,"rightIndent":0,"spaceBefore":0,"paragraphNumber":1},{"id":"matter-p-2","runs":[{"bold":false,"text":"Every teacher openly discussed several ideas about the new water supply in time for the festival at the end of the month. A careful reader clearly described the quarterly accounts so that everyone could understand the plan. The city council gladly shared stories about the city bus service after a long and useful discussion.","color":null,"italic":false,"strike":false,"fontSize":12,"highlight":null,"underline":false,"fontFamily":null}],"type":"paragraph","alignment":"left","listGroup":null,"leftIndent":0,"spaceAfter":8,"lineSpacing":1.15,"rightIndent":0,"spaceBefore":0,"paragraphNumber":2},{"id":"matter-p-3","runs":[{"bold":false,"text":"The morning newspaper published a short note on the quarterly accounts for the benefit of all the people nearby. Our research team clearly described the evening timetable as the afternoon light slowly faded away. Several visitors regularly recorded notes about the city bus service in time for the festival at the end of the month.","color":null,"italic":false,"strike":false,"fontSize":12,"highlight":null,"underline":false,"fontFamily":null}],"type":"paragraph","alignment":"left","listGroup":null,"leftIndent":0,"spaceAfter":8,"lineSpacing":1.15,"rightIndent":0,"spaceBefore":0,"paragraphNumber":3},{"id":"matter-p-4","runs":[{"bold":false,"text":"The sports club finally approved the school garden while the rain continued outside the hall. Most families prepared a detailed summary of the city bus service after a long and useful discussion. A group of volunteers gladly shared stories about the district fair once the final papers had arrived.","color":null,"italic":false,"strike":false,"fontSize":12,"highlight":null,"underline":false,"fontFamily":null}],"type":"paragraph","alignment":"left","listGroup":null,"leftIndent":0,"spaceAfter":8,"lineSpacing":1.15,"rightIndent":0,"spaceBefore":0,"paragraphNumber":4},{"id":"matter-p-5","runs":[{"bold":false,"text":"The committee published a short note on the winter exhibition so that everyone could understand the plan. Our local library openly discussed several ideas about the school garden after a long and useful discussion. The final examination thoroughly checked the new water supply once the final papers had arrived.","color":null,"italic":false,"strike":false,"fontSize":12,"highlight":null,"underline":false,"fontFamily":null}],"type":"paragraph","alignment":"left","listGroup":null,"leftIndent":0,"spaceAfter":8,"lineSpacing":1.15,"rightIndent":0,"spaceBefore":0,"paragraphNumber":5},{"id":"matter-p-6","runs":[{"bold":false,"text":"An experienced writer carefully reviewed the new water supply so the results could be shared on Friday. Every teacher prepared a detailed summary of the quarterly accounts while the rain continued outside the hall. A group of volunteers regularly recorded notes about the village health camp while the children watched with interest.","color":null,"italic":false,"strike":false,"fontSize":12,"highlight":null,"underline":false,"fontFamily":null}],"type":"paragraph","alignment":"left","listGroup":null,"leftIndent":0,"spaceAfter":8,"lineSp